*.class
*.war
*.ear

# --- 모든 .jar 파일은 기본적으로 무시합니다 (매우 중요) ---
*.jar

# Gradle 캐시
.gradle/
build/

# Maven (현재 사용하지 않더라도 유지)
target/
# (이하 Maven 관련 규칙들은 기존과 동일)
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

