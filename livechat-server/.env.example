# Local development only. Copy to .env.local and use scripts/dev-realtime.sh.
SERVER_HOST=127.0.0.1
SERVER_PORT=18443
SERVER_PROTOCOL=http
SOCKET_ALLOWED_ORIGINS=http://localhost:3107,http://127.0.0.1:3107,http://127.0.0.1:3108
MEDIASOUP_LISTEN_IP=127.0.0.1
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=10000
MEDIASOUP_MAX_PORT=10100
# External access needs reachable addresses, TLS termination and media routing.
# Do not expose this local configuration publicly; room authentication is pending.
