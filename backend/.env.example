# Copy to .env.local. Values are loaded only with the local Spring profile.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:18080/api/login/oauth2/code/google
LOCAL_API_URL=http://localhost:18080
LOCAL_WEB_URL=http://localhost:3107
LOCAL_ALLOWED_ORIGINS=http://localhost:3107,http://127.0.0.1:3107
DB_PASSWORD=generate-a-local-password
DB_ROOT_PASSWORD=generate-a-different-local-password
JWT_SECRET=generate-at-least-64-random-characters
STATE_SECRET=generate-at-least-64-random-characters
LOCAL_STORAGE_SECRET=generate-at-least-64-random-characters
