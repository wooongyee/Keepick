# syntax=docker/dockerfile:1
FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY backend/ ./
RUN --mount=type=cache,target=/root/.gradle bash ./gradlew --no-daemon bootJar -x test
FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 --create-home keepick && mkdir -p /app/images && chown -R keepick:keepick /app
WORKDIR /app
COPY --from=build /src/build/libs/*.jar /app/app.jar
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=60.0" SPRING_PROFILES_ACTIVE=local,homeserver
USER keepick
EXPOSE 8080
CMD ["java", "-jar", "/app/app.jar"]
